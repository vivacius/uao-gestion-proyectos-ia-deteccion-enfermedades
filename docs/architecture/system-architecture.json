  "cards": [
    {
      "dot": "emerald",
      "title": "Pipeline ML y CPU (Implementado M3)",
      "items": [
        "Preprocesamiento: Bicúbica 224x224, float32, media y std ImageNet",
        "Inferencia determinista: PyTorch 2.6.0 CPU bajo torch.no_grad()",
        "SafeTensors: Carga local sin conexión a red en runtime",
        "Postproceso: Softmax, mapeo a español, filtro tau=0.60 y descargo agronómico"
      ]
    },
    {
      "dot": "cyan",
      "title": "Servicio API e Interfaces (Implementado M3)",
      "items": [
        "FastAPI: Endpoints asíncronos /health, /predict y /docs OpenAPI",
        "Tkinter: aplicación de escritorio interactiva con visualización Top-3",
        "Web: frontend desacoplado HTML/CSS/JS con carga de imágenes y Top-3",
        "Alerta de baja certeza para técnicos agrícolas ante incertidumbre alta"
      ]
    },
    {
      "dot": "amber",
      "title": "Infraestructura de Despliegue (M4 — Implementación local)",
      "items": [
        "Empaquetado Wheel distribuible vía uv build",
        "Contenerización Docker CPU multi-etapa",
        "Orquestación Docker Compose para el servicio de API; interfaces Tkinter/web en el host"
      ]
    }

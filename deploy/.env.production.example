# =============================================================================
# Plantilla de variables NO secretas para el .env de la VPS (SPEC-047)
# =============================================================================
# El job deploy_vps genera este .env automaticamente en DEPLOY_PATH.
# Copia manual (solo para diagnostico):
#   cp deploy/.env.production.example .env
#
# NUNCA agregues tokens, claves SSH ni credenciales a este archivo.
# Los secretos viven en GitLab CI/CD Variables (protegidas/enmascaradas).
# =============================================================================

# Imagen publicada en el Container Registry del proyecto GitLab.
REGISTRY_IMAGE=registry.gitlab.com/vivacius/uao-gestion-proyectos-ia-deteccion-enfermedades

# SHA completo del commit desplegado (lo inyecta el pipeline).
IMAGE_TAG=0000000000000000000000000000000000000000

# Dominio publico con DNS A/AAAA apuntando a la VPS (sin https://).
DOMAIN=agroscan.example.com

# Limite de tamano de imagen aceptado por la API (MB).
MAX_IMAGE_SIZE_MB=10
